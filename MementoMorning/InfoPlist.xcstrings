{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to ring the alarm at your set time and stop it by answering today's question."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時刻にアラームを鳴らし、今日の問いに答えて止めるために使用します"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to record your video answer to the morning question with the front camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝の問いに答える動画をインカメラで録画するために使用します"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to record the audio of your video answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画回答の音声を録音するために使用します"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save your recorded video answers to the 'Memento Morning' album in Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画した動画回答を写真アプリのアルバム「Memento Morning」に保存するために使用します"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to transcribe the audio of your video answer into text on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画回答の音声を端末上でテキストに変換するために使用します"
          }
        }
      }
    }
  },
  "version": "1.0"
}
