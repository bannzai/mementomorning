        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した時刻にアラームを鳴らし、今日の問いに答えて止めるために使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정한 시간에 알람을 울리고 오늘의 질문에 답해 알람을 멈추는 데 사용됩니다."
