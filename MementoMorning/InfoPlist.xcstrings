        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å ringe alarmen på tidspunktet du har angitt, og stoppe den ved å svare på dagens spørsmål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt om het alarm op het ingestelde tijdstip te laten afgaan en te stoppen door de vraag van vandaag te beantwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do uruchamiania alarmu o ustawionej godzinie i zatrzymywania go przez odpowiedź na dzisiejsze pytanie."
