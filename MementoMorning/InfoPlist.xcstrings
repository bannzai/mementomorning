        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para tocar o alarme no horário definido e interrompê-lo ao responder à pergunta de hoje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para fazer tocar o alarme à hora definida e pará-lo ao responder à pergunta de hoje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosit pentru a suna alarma la ora setată și pentru a o opri răspunzând la întrebarea de azi."
