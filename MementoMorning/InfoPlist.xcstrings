        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để báo thức vào thời gian bạn đã đặt và tắt báo thức bằng cách trả lời câu hỏi hôm nay."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
