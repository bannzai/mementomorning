        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để báo thức vào thời gian bạn đã đặt và tắt báo thức bằng cách trả lời câu hỏi hôm nay."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在你設定的時間響起鬧鐘，並透過回答今天的問題來停止鬧鐘。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在你设置的时间响起闹钟，并通过回答今天的问题来停止闹钟。"
