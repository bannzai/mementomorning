  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لإطلاق المنبّه في الوقت الذي تحدّده وإيقافه بالإجابة عن سؤال اليوم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'utilitza per fer sonar l'alarma a l'hora que has configurat i aturar-la responent la pregunta d'avui."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k zazvonění budíku v nastavený čas a k jeho zastavení odpovědí na dnešní otázku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at ringe alarmen på det tidspunkt, du har indstillet, og stoppe den ved at besvare dagens spørgsmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um den Alarm zur festgelegten Zeit auszulösen und ihn durch Beantworten der heutigen Frage zu stoppen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για να ενεργοποιεί την αφύπνιση την ώρα που ορίσατε και να τη σταματά με την απάντηση στη σημερινή ερώτηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to ring the alarm at your set time and stop it by answering today's question."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para hacer sonar la alarma a la hora programada y detenerla respondiendo la pregunta de hoy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para hacer sonar la alarma a la hora programada y detenerla respondiendo la pregunta de hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään hälytyksen soittamiseen asettamanasi aikana ja sen pysäyttämiseen vastaamalla päivän kysymykseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour faire sonner l’alarme à l’heure définie et l’arrêter en répondant à la question du jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש להשמעת האזעקה בשעה שהגדרת ולעצירתה באמצעות מענה על שאלת היום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके निर्धारित समय पर अलार्म बजाने और आज के प्रश्न का उत्तर देकर उसे रोकने के लिए उपयोग किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za uključivanje alarma u vrijeme koje ste postavili i njegovo zaustavljanje odgovorom na današnje pitanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megadott időben megszólaltatja az ébresztést, és a mai kérdés megválaszolásával állítja le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk membunyikan alarm pada waktu yang Anda atur dan menghentikannya dengan menjawab pertanyaan hari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per far suonare la sveglia all’ora impostata e interromperla rispondendo alla domanda di oggi."
