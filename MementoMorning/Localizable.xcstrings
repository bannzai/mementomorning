          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazvoní v nastavenom čase aj v tichom režime."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer vid den valda tiden, även i tyst läge."
