    "Seven answers, together on one page for the first time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبع إجابات، مجتمعةً في صفحة واحدة للمرة الأولى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set respostes, juntes en una sola pàgina per primera vegada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedm odpovědí pohromadě na jedné stránce — poprvé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syv svar samlet på én side for første gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieben Antworten zum ersten Mal gemeinsam auf einer Seite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επτά απαντήσεις, συγκεντρωμένες σε μία σελίδα για πρώτη φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete respuestas, juntas en una sola página por primera vez."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete respuestas, juntas en una sola página por primera vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seitsemän vastausta ensimmäistä kertaa samalla sivulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sept réponses réunies sur une seule page pour la première fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שבע תשובות, יחד בעמוד אחד בפעם הראשונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहली बार सात जवाब एक ही पेज पर, साथ-साथ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedam odgovora, prvi put zajedno na jednoj stranici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hét válasz, először együtt egy oldalon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tujuh jawaban, untuk pertama kalinya dalam satu halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sette risposte, insieme su un’unica pagina per la prima volta."
          }
        },
