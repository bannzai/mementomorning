          "stringUnit" : {
            "state" : "translated",
            "value" : "V tvých odpovědích se stále vracelo jedno slovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dine svar blev ét ord ved med at dukke op."
