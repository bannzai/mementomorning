    "Rings at your time, even in silent mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرنّ في الوقت الذي تحدده، حتى في الوضع الصامت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sona a l’hora que triïs, fins i tot en mode silenciós."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazvoní v nastavený čas i v tichém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer på det valgte tidspunkt, selv i lydløs tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt zur eingestellten Zeit, auch im Lautlosmodus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτυπά την ώρα που έχεις ορίσει, ακόμη και σε αθόρυβη λειτουργία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a la hora que elijas, incluso en modo silencio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a la hora que elijas, incluso en modo silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälyttää valitsemaasi aikaan myös äänettömässä tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne à l’heure définie, même en mode silencieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצלצל בשעה שקבעת, גם במצב שקט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके तय समय पर, साइलेंट मोड में भी बजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvonit će u vrijeme koje odrediš, čak i u tihom načinu rada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállított időpontban csörög, néma módban is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbunyi pada waktu yang kamu tentukan, bahkan dalam mode hening."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona all’ora che scegli, anche in modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した時刻に、サイレントモードでも鳴ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드에서도 설정한 시간에 울려요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdering pada waktu yang anda tetapkan, walaupun dalam mod senyap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer på det valgte tidspunktet, selv i stillemodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat af op het ingestelde tijdstip, zelfs in stille modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzwoni o wybranej godzinie, nawet w trybie cichym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca no horário definido, mesmo no modo silencioso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca à hora definida, mesmo no modo silencioso."
          }
        },
        "ro" : {
          "stringUnit" : {
