    "If today were your last day, what would you want to do?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان اليوم هو آخر يوم لك، فماذا كنت ستفعل؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avui fos el teu últim dia, què t'agradaria fer?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdyby byl dnešek tvůj poslední den, co bys chtěl(a) dělat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis i dag var din sidste dag, hvad ville du så gerne gøre?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn heute dein letzter Tag wäre, was würdest du gern tun?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η σημερινή ήταν η τελευταία σου μέρα, τι θα ήθελες να κάνεις;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hoy fuera tu último día, ¿qué te gustaría hacer?"
