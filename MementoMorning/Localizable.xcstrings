        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לטעון את הסרטון. בדוק את החיבור ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो लोड नहीं हो सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video se nije mogao učitati. Provjeri vezu i pokušaj ponovno."
