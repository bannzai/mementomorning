{
  "sourceLanguage": "en",
  "strings": {
    "Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム"
          }
        }
      }
    },
    "Alarm & Notifications": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームと通知の許可"
          }
        }
      }
    },
    "Alarm & notification permissions are requested next": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の画面でアラームと通知の許可をお願いします"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可する"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        }
      }
    },
    "Answer one question each morning to stop the alarm.\nYour answers become the journal of your life.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝ひとつの問いに答えて、アラームを止める。\n答えは、あなたの人生のジャーナルになる。"
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        }
      }
    },
    "Answers older than 7 days unlock with Premium.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8 日以上前の回答はプレミアムで解放されます"
          }
        }
      }
    },
    "Are you keeping it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守れてますか?"
          }
        }
      }
    },
    "Begin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        }
      }
    },
    "Check tonight against this morning's answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答と答え合わせしましょう"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つづける"
          }
        }
      }
    },
    "Failed to save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました"
          }
        }
      }
    },
    "Failed to save. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました。もう一度お試しください"
          }
        }
      }
    },
    "I did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれた"
          }
        }
      }
    },
    "If today were your last day, what would you want to do?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日死ぬとしたら、何をやりたいか"
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナル"
          }
        }
      }
    },
    "Night reminder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜のリマインド"
          }
        }
      }
    },
    "No answer this morning yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答はまだありません"
          }
        }
      }
    },
    "Not answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未回答"
          }
        }
      }
    },
    "Not yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれていない"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "Recorded: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済み: %@"
          }
        }
      }
    },
    "Remember death.\nThen begin your morning.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "死を想ってから、\n朝を始める。"
          }
        }
      }
    },
    "Rings at your time, even in silent mode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時刻に、サイレントモードでも鳴ります"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Set alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームをセットする"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止める"
          }
        }
      }
    },
    "Stop Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止める"
          }
        }
      }
    },
    "Stop the alarm and open Memento Morning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを停止して Memento Morning を開きます"
          }
        }
      }
    },
    "The alarm keeps returning until you answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えるまで、アラームは鳴り続けます"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻"
          }
        }
      }
    },
    "You can change permissions in the Settings app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可は設定アプリから変更できます"
          }
        }
      }
    },
    "Your answers will gather here, one morning at a time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は、ひと朝ずつここに集まっていきます"
          }
        }
      }
    },
    "Your first alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のアラーム"
          }
        }
      }
    }
  },
  "version": "1.0"
}
