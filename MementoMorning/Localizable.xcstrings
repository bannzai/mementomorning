    "If today were your last day, what would you want to do?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لو كان اليوم آخر يوم لك، فماذا تريد أن تفعل؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avui fos el teu últim dia, què voldries fer?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdyby byl dnešek tvým posledním dnem, co bys chtěl udělat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis i dag var din sidste dag, hvad ville du så gerne lave?"
