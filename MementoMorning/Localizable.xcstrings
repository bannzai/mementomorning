{
  "sourceLanguage": "en",
  "strings": {
    "Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム"
          }
        }
      }
    },
    "All your history": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての履歴"
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        }
      }
    },
    "Answers older than 7 days unlock with Premium.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8 日以上前の回答はプレミアムで解放されます"
          }
        }
      }
    },
    "Are you keeping it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守れてますか?"
          }
        }
      }
    },
    "Cancel anytime. Your answers stay on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも解約できます。回答はこの端末に残ります。"
          }
        }
      }
    },
    "Check tonight against this morning's answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答と答え合わせしましょう"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Endless follow-up alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無限追撃アラーム"
          }
        }
      }
    },
    "Every answer, beyond the last 7 days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 7 日を超えた、すべての回答"
          }
        }
      }
    },
    "Failed to save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました"
          }
        }
      }
    },
    "Failed to save. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました。もう一度お試しください"
          }
        }
      }
    },
    "I did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれた"
          }
        }
      }
    },
    "If today were your last day, what would you want to do?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日死ぬとしたら、何をやりたいか"
          }
        }
      }
    },
    "It won't stop ringing until you answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えるまで、鳴りやまない"
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナル"
          }
        }
      }
    },
    "Keep every morning.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての朝を、残すために。"
          }
        }
      }
    },
    "Meet your past self again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の自分と、再会する"
          }
        }
      }
    },
    "Milestones at 30, 90, and 180 days": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30・90・180 日の節目"
          }
        }
      }
    },
    "Monthly %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月 %@"
          }
        }
      }
    },
    "More ways to ask the morning question.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝の問いに、別の切り口を"
          }
        }
      }
    },
    "No answer this morning yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答はまだありません"
          }
        }
      }
    },
    "No purchases to restore were found.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元できる購入が見つかりませんでした。"
          }
        }
      }
    },
    "Not answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未回答"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        }
      }
    },
    "Not yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれていない"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Premium": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアム"
          }
        }
      }
    },
