    "Is there something you keep telling yourself you'll do?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هناك شيء تواصل إخبار نفسك بأنك ستفعله؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha alguna cosa que et repeteixes que faràs?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je něco, co si pořád říkáš, že uděláš?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er der noget, du bliver ved med at sige til dig selv, at du vil gøre?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es etwas, von dem du dir immer wieder sagst, dass du es tun wirst?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει κάτι που λες συνεχώς στον εαυτό σου ότι θα κάνεις;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay algo que sigues diciéndote que harás?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay algo que sigues diciéndote que harás?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko jotain, mitä sanot itsellesi jatkuvasti tekeväsi?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y a-t-il quelque chose que vous vous dites sans cesse que vous ferez ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש משהו שאתה ממשיך לומר לעצמך שתעשה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या कोई ऐसी चीज़ है, जिसे आप ख़ुद से कहते रहते हैं कि आप करेंगे?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
