          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste inn videoen. Sjekk tilkoblingen din og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de video niet laden. Controleer je verbinding en probeer het opnieuw."
