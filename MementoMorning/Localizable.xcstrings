    },
    "Are you keeping it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守れてますか?"
          }
        }
      }
    },
    "Blank days remain blank.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白は空白のまま残ります"
          }
        }
      }
    },
    "Blank stays blank.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白は、空白のまま。"
          }
        }
      }
    },
    "Cancel anytime. Your answers stay on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも解約できます。回答はこの端末に残ります。"
          }
        }
      }
    },
    "Check tonight against this morning's answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答と答え合わせしましょう"
