    "Answer one question each morning to stop the alarm.\nYour answers become the journal of your life." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن سؤال واحد كل صباح لإيقاف المنبّه.\nتصبح إجاباتك سجلًا لحياتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respon una pregunta cada matí per aturar l’alarma.\nLes teves respostes es converteixen en el diari de la teva vida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé ráno odpověz na jednu otázku a zastav budík.\nTvé odpovědi se stanou deníkem tvého života."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besvar ét spørgsmål hver morgen for at slukke alarmen.\nDine svar bliver din livsjournal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte jeden Morgen eine Frage, um den Wecker auszuschalten.\nDeine Antworten werden zum Journal deines Lebens."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απάντησε κάθε πρωί σε μία ερώτηση για να σταματήσεις το ξυπνητήρι.\nΟι απαντήσεις σου γίνονται το ημερολόγιο της ζωής σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde una pregunta cada mañana para apagar la alarma.\nTus respuestas se convierten en el diario de tu vida."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde una pregunta cada mañana para apagar la alarma.\nTus respuestas se convierten en el diario de tu vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa joka aamu yhteen kysymykseen pysäyttääksesi herätyksen.\nVastauksistasi muodostuu elämäsi päiväkirja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à une question chaque matin pour arrêter l’alarme.\nVos réponses deviennent le journal de votre vie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ענה על שאלה אחת בכל בוקר כדי לעצור את השעון המעורר.\nהתשובות שלך הופכות ליומן חייך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सुबह अलार्म बंद करने के लिए एक सवाल का जवाब दें।\nआपके जवाब आपकी ज़िंदगी की डायरी बन जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako jutro odgovori na jedno pitanje kako bi zaustavio alarm.\nTvoji odgovori postaju dnevnik tvog života."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden reggel válaszolj egy kérdésre az ébresztő leállításához.\nA válaszaidból lesz az életed naplója."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab satu pertanyaan setiap pagi untuk menghentikan alarm.\nJawabanmu menjadi jurnal hidupmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi a una domanda ogni mattina per fermare la sveglia.\nLe tue risposte diventano il diario della tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎朝ひとつの問いに答えて、アラームを止める。\n答えは、あなたの人生のジャーナルになる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 아침 질문 하나에 답해 알람을 멈춰 보세요.\n답변은 삶의 저널이 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab satu soalan setiap pagi untuk menghentikan penggera.\nJawapan anda menjadi jurnal hidup anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar på ett spørsmål hver morgen for å stoppe alarmen.\nSvarene dine blir livsjournalen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord elke ochtend één vraag om het alarm uit te zetten.\nJe antwoorden worden het dagboek van je leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz każdego ranka na jedno pytanie, aby wyłączyć alarm.\nTwoje odpowiedzi stają się dziennikiem Twojego życia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a uma pergunta todas as manhãs para desligar o alarme.\nSuas respostas se tornam o diário da sua vida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde a uma pergunta todas as manhãs para desligar o alarme.\nAs tuas respostas tornam-se o diário da tua vida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Răspunde la o întrebare în fiecare dimineață pentru a opri alarma.\nRăspunsurile tale devin jurnalul vieții tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое утро отвечайте на один вопрос, чтобы выключить будильник.\nВаши ответы станут дневником вашей жизни."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé ráno odpovedz na jednu otázku a zastav budík.\nTvoje odpovede sa stanú denníkom tvojho života."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svara på en fråga varje morgon för att stänga av alarmet.\nDina svar blir din livsjournal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอบคำถามหนึ่งข้อทุกเช้าเพื่อหยุดการปลุก\nคำตอบของคุณจะกลายเป็นบันทึกชีวิตของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmı durdurmak için her sabah bir soruyu yanıtla.\nYanıtların hayatının günlüğüne dönüşür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоранку відповідайте на одне запитання, щоб вимкнути будильник.\nВаші відповіді стануть щоденником вашого життя."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả lời một câu hỏi mỗi sáng để tắt báo thức.\nCâu trả lời của bạn sẽ trở thành nhật ký cuộc đời bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天早上回答一條問題，才能關閉鬧鐘。\n你的答案會成為你的人生日誌。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天早上回答一个问题，才能关闭闹钟。\n你的回答会成为你的人生日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天早上回答一個問題，才能關閉鬧鐘。\n你的回答會成為你的人生日誌。"
          }
        }
      }
    },
