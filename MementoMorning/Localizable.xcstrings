          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svara på en fråga varje morgon för att stoppa alarmet.\nDina svar blir din livsdagbok."
          }
        },
        "th" : {
          "stringUnit" : {
