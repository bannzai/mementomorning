        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar el video. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videon lataaminen epäonnistui. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger la vidéo. Vérifiez votre connexion et réessayez."
