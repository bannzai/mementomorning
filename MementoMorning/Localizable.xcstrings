    "Answer one question each morning to stop the alarm.\nYour answers become the journal of your life." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن سؤال واحد كل صباح لإيقاف المنبّه.\nتُصبح إجاباتك يوميات حياتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respon una pregunta cada matí per aturar l'alarma.\nLes teves respostes es converteixen en el diari de la teva vida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé ráno odpověz na jednu otázku a zastav budík.\nTvé odpovědi se stanou deníkem tvého života."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar på ét spørgsmål hver morgen for at stoppe alarmen.\nDine svar bliver til din livsjournal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte jeden Morgen eine Frage, um den Wecker zu stoppen.\nDeine Antworten werden zum Journal deines Lebens."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απάντησε σε μία ερώτηση κάθε πρωί για να σταματήσεις την ειδοποίηση.\nΟι απαντήσεις σου γίνονται το ημερολόγιο της ζωής σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde una pregunta cada mañana para detener la alarma.\nTus respuestas se convierten en el diario de tu vida."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde una pregunta cada mañana para detener la alarma.\nTus respuestas se convierten en el diario de tu vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa yhteen kysymykseen joka aamu, niin hälytys pysähtyy.\nVastauksistasi tulee elämäsi päiväkirja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à une question chaque matin pour arrêter l'alarme.\nVos réponses deviennent le journal de votre vie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ענה על שאלה אחת בכל בוקר כדי לעצור את האזעקה.\nהתשובות שלך הופכות ליומן החיים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म बंद करने के लिए हर सुबह एक सवाल का जवाब दें।\nआपके जवाब आपकी ज़िंदगी की डायरी बन जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgovori na jedno pitanje svako jutro da zaustaviš alarm.\nTvoji odgovori postaju dnevnik tvog života."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszolj egy kérdésre minden reggel, hogy leállítsd az ébresztőt.\nA válaszaidból lesz az életed naplója."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab satu pertanyaan setiap pagi untuk menghentikan alarm.\nJawabanmu menjadi jurnal hidupmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi a una domanda ogni mattina per fermare la sveglia.\nLe tue risposte diventano il diario della tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎朝ひとつの問いに答えて、アラームを止める。\n答えは、あなたの人生のジャーナルになる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알람을 끄려면 매일 아침 한 가지 질문에 답하세요.\n당신의 답변은 삶의 기록이 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab satu soalan setiap pagi untuk menghentikan alarm.\nJawapan anda menjadi jurnal hidup anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar på ett spørsmål hver morgen for å stoppe alarmen.\nSvarene dine blir livets dagbok."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord elke ochtend één vraag om het alarm te stoppen.\nJe antwoorden worden het dagboek van je leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
