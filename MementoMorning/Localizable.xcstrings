    "Rings at your time, even in silent mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرنّ في الوقت الذي تحدده، حتى في الوضع الصامت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sona a l’hora que triïs, fins i tot en mode silenciós."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazvoní v nastavený čas i v tichém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer på det valgte tidspunkt, selv i lydløs tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt zur eingestellten Zeit, auch im Lautlosmodus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτυπά την ώρα που έχεις ορίσει, ακόμη και σε αθόρυβη λειτουργία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a la hora que elijas, incluso en modo silencio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a la hora que elijas, incluso en modo silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hälyttää valitsemaasi aikaan myös äänettömässä tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne à l’heure définie, même en mode silencieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצלצל בשעה שקבעת, גם במצב שקט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके तय समय पर, साइलेंट मोड में भी बजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvonit će u vrijeme koje odrediš, čak i u tihom načinu rada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beállított időpontban csörög, néma módban is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbunyi pada waktu yang kamu tentukan, bahkan dalam mode hening."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
