          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda la muerte.\nLuego comienza tu mañana."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
