    "Will you do yesterday's answer today?" : {
      "comment" : "昨日答えた内容 (やりたいこと) を今日実行するか、を問う選択肢の見出し。「回答という行為をする」ではなく「昨日答えたことを今日やる」の意味",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ستفعل اليوم ما أجبتَ به أمس؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faràs avui el que vas respondre ahir?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uskutečníš dnes svou včerejší odpověď?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du gøre det i dag, du svarede i går?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirst du heute umsetzen, was du gestern geantwortet hast?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα κάνεις σήμερα αυτό που απάντησες χθες;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Harás hoy lo que respondiste ayer?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Harás hoy lo que respondiste ayer?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teetkö tänään sen, mitä vastasit eilen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferez-vous aujourd’hui ce que vous avez répondu hier ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם תעשה היום את מה שענית אתמול?"
          }
        },
