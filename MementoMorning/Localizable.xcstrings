{
  "sourceLanguage": "en",
  "strings": {
    "Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム"
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        }
      }
    },
    "Answers older than 7 days unlock with Premium.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8 日以上前の回答はプレミアムで解放されます"
          }
        }
      }
    },
    "Failed to save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました"
          }
        }
      }
    },
    "If today were your last day, what would you want to do?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日死ぬとしたら、何をやりたいか"
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナル"
          }
        }
      }
    },
    "Not answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未回答"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止める"
          }
        }
      }
    },
    "Stop Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止める"
          }
        }
      }
    },
    "Stop the alarm and open Memento Morning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを停止して Memento Morning を開きます"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻"
          }
        }
      }
    },
    "Your answers will gather here, one morning at a time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は、ひと朝ずつここに集まっていきます"
          }
        }
      }
    },
    "Are you keeping it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守れてますか?"
          }
        }
      }
    },
    "Check tonight against this morning's answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答と答え合わせしましょう"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Failed to save. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました。もう一度お試しください"
          }
        }
      }
    },
    "I did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれた"
          }
        }
      }
    },
    "No answer this morning yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答はまだありません"
          }
        }
      }
    },
    "Not yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれていない"
          }
        }
      }
    },
    "Recorded: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済み: %@"
          }
        }
      }
    },
    "Seven Mornings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "七つの朝"
          }
        }
      }
    },
    "Seven answers, together on one page for the first time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "七日分の答えが、はじめて一枚に並びました"
          }
        }
      }
    }
  },
  "version": "1.0"
}
