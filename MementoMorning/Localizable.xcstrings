        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상을 불러올 수 없어요. 연결 상태를 확인하고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
