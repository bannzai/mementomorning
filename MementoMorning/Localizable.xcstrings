    "Older mornings unlock with Premium." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح الصباحات الأقدم مع Premium."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els matins anteriors s’obren amb Premium."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starší rána se odemknou s Premium."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ældre morgener låses op med Premium."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Morgen werden mit Premium freigeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα παλαιότερα πρωινά ξεκλειδώνουν με το Premium."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mañanas anteriores se desbloquean con Premium."
          }
        },
