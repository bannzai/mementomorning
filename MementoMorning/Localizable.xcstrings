    "Remember death.\nThen begin your morning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكّر الموت.\nثم ابدأ صباحك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorda la mort.\nDesprés, comença el teu matí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatuj na smrt.\nPak začni své ráno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk døden.\nOg begynd så din morgen."
          }
        },
        "de" : {
          "stringUnit" : {
