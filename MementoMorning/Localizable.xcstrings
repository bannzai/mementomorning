    "Across your answers, one word kept returning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في إجاباتك، ظلت كلمة واحدة تتكرر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En les teves respostes, una paraula seguia apareixent."
          }
