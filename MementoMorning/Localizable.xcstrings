    "In the morning, stopping the recording stops the alarm." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الصباح، إيقاف التسجيل يوقف المنبّه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al matí, en aturar la gravació s’atura l’alarma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ráno zastavením nahrávání zastavíte budík."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om morgenen stopper du alarmen ved at stoppe optagelsen."
          }
        },
