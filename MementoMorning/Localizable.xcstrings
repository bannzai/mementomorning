          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        }
      }
    },
    "Failed to save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました"
          }
        }
      }
    },
    "If today were your last day, what would you want to do?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日死ぬとしたら、何をやりたいか"
          }
        }
      }
    },
    "Journal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナル"
          }
        }
      }
    },
    "Not answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未回答"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止める"
          }
        }
      }
    },
    "Stop Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止める"
          }
        }
      }
    },
    "Stop the alarm and open Memento Morning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを停止して Memento Morning を開きます"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻"
          }
        }
      }
    },
    "Your answers will gather here, one morning at a time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は、ひと朝ずつここに集まっていきます"
          }
        }
      }
    },
    "Are you keeping it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守れてますか?"
          }
        }
      }
    },
    "Check tonight against this morning's answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答と答え合わせしましょう"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Failed to save. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました。もう一度お試しください"
          }
        }
      }
    },
    "I did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれた"
          }
        }
      }
    },
    "No answer this morning yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝の回答はまだありません"
          }
        }
      }
    },
    "Not yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれていない"
          }
        }
      }
    },
    "Recorded: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済み: %@"
          }
        }
      }
    },
    "%lld mornings answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えた朝 %lld"
          }
        }
      }
    },
    "All your mornings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての履歴"
          }
        }
      }
    },
    "Answer with the keyboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードで答える"
          }
        }
      }
    },
    "Beyond the one question you know.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日死ぬとしたら」の先へ"
          }
        }
      }
    },
    "Blank days remain blank.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白は空白のまま残ります"
          }
        }
      }
    },
    "Blank stays blank.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白は、空白のまま。"
          }
        }
      }
    },
    "Cancel anytime. Your answers stay on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも解約できます。回答はこの端末に残ります。"
          }
        }
      }
    },
    "Days you meet your past self again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の自分と再会する日"
          }
        }
      }
    },
    "Each row is a week. Answered mornings remain as ink.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行が一週間。答えた朝が、墨として残る。"
          }
        }
      }
    },
    "Endless follow-up alarms": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無限追撃アラーム"
          }
        }
      }
    },
    "Every morning, beyond the last 7 days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日を越えて、すべての朝を"
          }
        }
      }
    },
    "In %lld hr %lld min · Tap the time to change": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと %lld 時間 %lld 分 · 時刻をタップして変更"
          }
        }
      }
    },
    "It keeps ringing until you answer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えるまで、鳴りやまない"
          }
        }
      }
    },
    "Life Calendar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人生カレンダー"
          }
        }
      }
    },
    "Milestones at 30, 90, and 180 days": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30・90・180日の節目"
          }
        }
      }
    },
    "NEXT MORNING": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の朝 · NEXT MORNING"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "Older mornings unlock with Premium.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日より前の朝は、プレミアムで。"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "Question decks": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問いのデッキ"
          }
        }
      }
    },
    "See every morning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての朝を見る"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Speak your answer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話して、答える"
          }
        }
      }
    },
    "Stop, and the alarm stops too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止めると、アラームも止まります"
          }
        }
      }
    },
    "Tap the time to set your alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻をタップして設定"
          }
        }
      }
    },
    "This morning's words": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今朝のことば"
          }
        }
      }
    },
    "To keep every morning.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての朝を、残すために。"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        }
      }
    },
    "¥3,600 / year": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年 ¥3,600"
          }
        }
      }
    },
    "¥300 a month": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと月 ¥300"
          }
        }
      }
    },
    "¥480 / month": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月 ¥480"
          }
        }
      }
    },
    "Alarm is off · Tap the time to change": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームはオフ · 時刻をタップして変更"
          }
        }
      }
    },
    "Seven Mornings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "七つの朝"
          }
        }
      }
    },
    "Seven answers, together on one page for the first time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "七日分の答えが、はじめて一枚に並びました"
          }
        }
      }
    }
  },
  "version": "1.0"
