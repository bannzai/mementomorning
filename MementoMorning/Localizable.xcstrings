      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシー"
          }
        }
      }
    },
    "Purchases aren't ready yet. Please try again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入はまだ準備できていません。しばらくしてからお試しください。"
          }
        }
      }
    },
    "Purchases couldn't be restored.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元できませんでした。"
          }
        }
      }
    },
