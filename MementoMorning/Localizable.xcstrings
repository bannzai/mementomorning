        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha é uma semana. As manhãs respondidas permanecem como pontos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
