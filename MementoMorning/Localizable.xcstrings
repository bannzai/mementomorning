      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済み: %@"
          }
        }
      }
    },
    "Restore Purchases": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Snooze": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スヌーズ"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止める"
          }
        }
      }
    },
    "Stop Alarm": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止める"
          }
        }
      }
    },
    "Stop the alarm and open Memento Morning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを停止して Memento Morning を開きます"
          }
        }
      }
    },
    "Terms of Use": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
          }
        }
      }
    },
    "The purchase couldn't be completed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。"
          }
        }
      }
    },
    "The purchase finished, but Premium couldn't be confirmed. Please try restoring purchases later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、プレミアムの反映を確認できませんでした。時間をおいて購入の復元をお試しください。"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻"
          }
        }
      }
    },
    "Unlimited": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限"
          }
        }
      }
    },
    "Up to %lld times (free)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回まで (無料)"
          }
        }
      }
    },
    "Yearly %@ (%@ a month)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年 %1$@(ひと月 %2$@)"
          }
        }
      }
    },
    "Your answers will gather here, one morning at a time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答は、ひと朝ずつここに集まっていきます"
          }
        }
      }
    }
  },
  "version": "1.0"
}
