        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A videó betöltése nem sikerült. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video tidak dapat dimuat. Periksa koneksi kamu dan coba lagi."
