      }
    },
    "Close": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "Each row is a week. Answered mornings remain as ink.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行が一週間。答えた朝が、墨として残る。"
