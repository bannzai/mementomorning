    "Remember death.\nThen begin your morning." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكّر الموت.\nثم ابدأ صباحك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorda la mort.\nDesprés, comença el teu matí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatuj na smrt.\nPoté začni své ráno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk døden.\nBegynd derefter din morgen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denke an den Tod.\nDann beginne deinen Morgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να θυμάσαι τον θάνατο.\nΎστερα ξεκίνα το πρωινό σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda la muerte.\nDespués, comienza tu mañana."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda la muerte.\nLuego, comienza tu mañana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista kuolema.\nAloita sitten aamusi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souvenez-vous de la mort.\nPuis commencez votre matinée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זכור את המוות.\nאחר כך התחל את הבוקר שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मृत्यु को याद रखें।\nफिर अपनी सुबह शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjeti se smrti.\nZatim započni svoje jutro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emlékezz a halálra.\nAztán kezdd el a reggeledet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingatlah kematian.\nLalu mulailah pagimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda la morte.\nPoi inizia la tua mattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "死を想ってから、\n朝を始める。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "죽음을 기억하세요.\n그런 다음 아침을 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingatlah kematian.\nKemudian mulakan pagi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk døden.\nBegynn så morgenen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk aan de dood.\nBegin daarna aan je ochtend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamiętaj o śmierci.\nPotem zacznij swój poranek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembre-se da morte.\nEntão comece sua manhã."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
