          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дзвонить у ваш час, навіть у беззвучному режимі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kêu vào giờ của bạn, ngay cả khi ở chế độ im lặng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
