    "Purchases aren't ready yet. Please try again later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المشتريات غير جاهزة بعد. يُرجى المحاولة مرة أخرى لاحقًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compres encara no estan a punt. Torna-ho a provar més tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy zatím nejsou připravené. Zkuste to prosím později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køb er ikke klar endnu. Prøv igen senere."
