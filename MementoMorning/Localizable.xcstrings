    "No more snoozing\nOnly your answer stops the alarm" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا مزيد من الغفوة\nإجابتك وحدها توقف المنبّه"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prou d’ajornar l’alarma\nNomés la teva resposta atura l’alarma"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už žádné odkládání\nBudík zastaví jen tvoje odpověď"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke mere snooze\nKun dit svar stopper alarmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Schlummern mehr\nNur deine Antwort stoppt den Wecker"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τέρμα η αναβολή\nΜόνο η απάντησή σου σταματά το ξυπνητήρι"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se acabó posponer\nSolo tu respuesta detiene la alarma"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No más posponer\nSolo tu respuesta detiene la alarma"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei enää torkutusta\nVain vastauksesi sammuttaa herätyksen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fini les reports\nSeule votre réponse arrête l’alarme"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא עוד נודניק\nרק התשובה שלך עוצרת את השעון המעורר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब स्नूज़ नहीं\nसिर्फ़ आपका जवाब अलार्म बंद करेगा"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema više odgode\nAlarm zaustavlja samo tvoj odgovor"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs több szundi\nCsak a válaszod állítja le az ébresztőt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak ada lagi tunda\nHanya jawabanmu yang menghentikan alarm"
          }
        },
        "it" : {
          "stringUnit" : {
