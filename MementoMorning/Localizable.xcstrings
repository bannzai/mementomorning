    "Say the things I've never been able to say" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل الأشياء التي لم أستطع قولها قط"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digues les coses que mai no he pogut dir"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni věci, které se mi nikdy nepodařilo říct"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig de ting, jeg aldrig har kunnet sige"
