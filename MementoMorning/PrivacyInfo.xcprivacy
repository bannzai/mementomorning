<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- アプリ本体の Privacy Manifest。宣言内容の根拠と洗い出しの経緯は documents/app-privacy.md を参照。
	     RevenueCat SDK (purchases-ios) の収集データ・Required Reason API は SDK 同梱の
	     PrivacyInfo.xcprivacy (SPM resource) が宣言するため、ここには重複して書かない -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- 自アプリの UserDefaults 使用 (@AppStorage / UserDefaults.standard)。
			     CA92.1: アプリ自身がアクセスする情報 (オンボーディング完了フラグ・entitlement キャッシュ等) の読み書き -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
