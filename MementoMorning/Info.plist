<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 権限の説明文はアプリの基準言語 (英語) で書き、日本語は InfoPlist.xcstrings で提供する。
	     InfoPlist.xcstrings に en の値が無いと、生成される en.lproj/InfoPlist.strings がキー名に
	     フォールバックして OS のダイアログにキー名が表示されるため (issue #50)、
	     同じ英文を InfoPlist.xcstrings の en にも持たせる。文言を変える時は両方を合わせて更新する -->
	<!-- 輸出コンプライアンスの事前回答。通信は RevenueCat SDK の HTTPS のみで、
	     免除対象外の暗号化を使わないため false (ADR 0001)。これが無いと TestFlight の
	     ビルドが Missing Compliance で止まり、内部テスターへの自動配布が進まない -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Used to ring the alarm at your set time and stop it by answering today's question.</string>
	<key>NSCameraUsageDescription</key>
	<string>Used to record your video answer to the morning question with the front camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used to record the audio of your video answer.</string>
	<key>NSMotionUsageDescription</key>
	<string>Used to tilt the device and let the piled dots of your answered mornings roll.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to save your recorded video answers to the 'Memento Morning' album in Photos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to transcribe the audio of your video answer into text on this device.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
</dict>
</plist>
